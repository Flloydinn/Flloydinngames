<!doctype html>
<html lang="pt-br">
<head>
<meta charset="utf-8">
<title>Space Courier 3D — Asteroid Run</title>
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1">
<meta name="description" content="Arcade 3D no espaço: desvie de asteroides, colete dados e bata seu recorde.">
<link rel="icon" href="assets/favicon.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;800&display=swap" rel="stylesheet">
<style>
  :root{ --bg:#0b0b0c; --bg2:#121316; --text:#E8E8EA; --muted:#A6A6AD;
         --brand:#8f0000; --brand2:#b31212; --border:#24262b; --card:#1a1a1a; --ok:#57d996; --warn:#ffb84d; --bad:#ff6b6b; }
  *{box-sizing:border-box} html,body{height:100%}
  body{margin:0;background:linear-gradient(180deg,#0b0b0c 0%, #0d0e12 40%, #0b0b0c 100%);color:var(--text);font-family:Inter,system-ui,Segoe UI,Roboto,Arial,sans-serif;overflow:hidden}

  .topbar{position:fixed;inset:0 0 auto 0;z-index:30;background:rgba(11,11,12,.6);backdrop-filter:blur(6px);border-bottom:1px solid var(--border)}
  .topbar .row{width:min(1200px,calc(100% - 2rem));margin:0 auto;display:flex;align-items:center;justify-content:space-between;padding:.55rem 0}
  .brand{font-weight:800;letter-spacing:.3px}.brand span{color:var(--brand)}
  .nav{display:flex;gap:.5rem}
  .btn{background:linear-gradient(135deg,var(--brand) 0%, var(--brand2) 100%);border:0;border-radius:.6rem;color:#fff;padding:.45rem .7rem;font-weight:700;cursor:pointer}
  .btn--ghost{background:transparent;border:1px solid var(--border)} .btn--small{font-size:.9rem}

  #game{position:fixed;inset:48px 0 0 0;display:block;background:#000}
  .hud{position:fixed;inset:48px 0 0 0;pointer-events:none}
  .panel{position:absolute;left:12px;bottom:12px;background:rgba(16,18,24,.7);border:1px solid var(--border);border-radius:.8rem;padding:.6rem;min-width:250px}
  .row{display:flex;gap:.45rem;align-items:center;flex-wrap:wrap}
  .bar{flex:1;height:10px;border:1px solid var(--border);border-radius:6px;overflow:hidden;background:#0f1116}
  .bar>span{display:block;height:100%;background:linear-gradient(135deg,#2db57f,#57d996)}
  .stat{font-weight:800}.meta{color:var(--muted);font-size:.9rem}
  .badge{font-size:.75rem;background:rgba(0,0,0,.5);border:1px solid var(--border);padding:.15rem .45rem;border-radius:.4rem;font-weight:700}
  .toast{position:absolute;left:50%;top:64px;transform:translateX(-50%);background:rgba(0,0,0,.6);border:1px solid var(--border);padding:.5rem .8rem;border-radius:.6rem;display:none}
  .topright{position:absolute;right:12px;top:56px;display:flex;gap:.35rem}
  .chip{background:rgba(0,0,0,.5);border:1px solid var(--border);border-radius:.6rem;padding:.25rem .5rem}

  .overlay{position:fixed;inset:48px 0 0 0;display:none;align-items:center;justify-content:center;background:rgba(0,0,0,.6);z-index:20}
  .overlay.open{display:flex}
  .modal{width:min(900px,calc(100% - 2rem));background:var(--bg2);border:1px solid var(--border);border-radius:1rem;padding:1rem}
  .grid-2{display:grid;grid-template-columns:1fr 1fr;gap:1rem}
  .input{width:100%;background:#0d0f14;border:1px solid var(--border);border-radius:.6rem;color:#fff;padding:.6rem .7rem}

  .mobile{position:fixed;inset:auto 0 10px 0;display:none;justify-content:space-between;padding:0 10px;z-index:25}
  .pad{width:120px;height:120px;border-radius:60px;background:rgba(16,18,24,.6);border:1px solid var(--border);position:relative}
  .stick{position:absolute;width:56px;height:56px;border-radius:28px;background:#222;border:1px solid var(--border);left:32px;top:32px}
  .btnR{width:68px;height:68px;border-radius:999px;background:rgba(16,18,24,.6);border:1px solid var(--border);display:grid;place-items:center;color:#fff;font-weight:800}
  @media (max-width:900px){.mobile{display:flex}}
</style>
</head>
<body>
  <div class="topbar">
    <div class="row">
      <div class="brand"><a href="index.html" style="color:#fff;text-decoration:none">Flloyd<span>inn</span> Gameplay</a> <span class="meta">/ Space Courier 3D</span></div>
      <div class="nav">
        <a class="btn btn--ghost btn--small" href="videos.html">Vídeos</a>
        <a class="btn btn--ghost btn--small" href="blognews.html">Blog</a>
        <a class="btn btn--ghost btn--small" href="loja.html">Loja</a>
        <button id="btnHelp" class="btn btn--small">Como jogar</button>
      </div>
    </div>
  </div>

  <canvas id="game"></canvas>

  <div class="hud" aria-hidden="true">
    <div class="panel">
      <div class="row"><span class="meta">Score</span><span id="score" class="stat">0</span> • <span class="meta">Wave</span><span id="wave" class="stat">1</span> • <span class="meta">Combo</span><span id="combo" class="stat">x1</span></div>
      <div class="row" style="margin:.35rem 0 .15rem"><span class="meta">Escudo</span><div class="bar"><span id="shieldBar" style="width:100%"></span></div></div>
      <div class="row"><span class="meta">Boost</span><div class="bar"><span id="boostBar" style="width:60%"></span></div></div>
      <div class="row"><span class="badge">WASD/Setas mover • Mouse mirar • Espaço/Click atirar • Shift boost</span></div>
    </div>
    <div class="topright">
      <div class="chip">High: <strong id="best">—</strong></div>
      <div class="chip">Minimapa: <span id="mapState">OFF</span></div>
    </div>
    <div id="toast" class="toast">+100</div>
    <div id="mapWrap" style="position:absolute;right:12px;bottom:12px;display:none;background:rgba(16,18,24,.7);border:1px solid var(--border);border-radius:.8rem;padding:.4rem">
      <canvas id="map" width="160" height="160" style="width:160px;height:160px;border-radius:.4rem;border:1px solid var(--border)"></canvas>
    </div>
  </div>

  <div class="overlay" id="pause">
    <div class="modal">
      <h2>Pausa</h2>
      <div class="grid-2">
        <div>
          <p class="meta">Objetivo: sobreviva, destrua asteroides, colete <strong>Datas</strong> (cubos azuis) e mantenha o combo!</p>
          <p class="meta"><strong>P</strong> pausa • <strong>M</strong> minimapa • <strong>F</strong> farol</p>
          <div class="row" style="margin-top:.6rem">
            <button id="btnResume" class="btn">Continuar</button>
            <button id="btnReset" class="btn btn--ghost">Reiniciar</button>
            <button id="btnClearSave" class="btn btn--ghost">Apagar high-score</button>
          </div>
        </div>
        <div>
          <label class="meta">Sensibilidade do mouse
            <input id="sens" class="input" type="range" min="0.2" max="2.0" step="0.1" value="1">
          </label>
          <label class="meta">Volume (efeitos)
            <input id="vol" class="input" type="range" min="0" max="1" step="0.05" value="0.5">
          </label>
        </div>
      </div>
    </div>
  </div>

  <div class="mobile" id="mobile">
    <div class="pad" id="pad"><div class="stick" id="stick"></div></div>
    <div style="display:flex;gap:10px">
      <div class="btnR" id="btnShoot">●</div>
      <div class="btnR" id="btnBoost">⚡</div>
    </div>
  </div>

  <!-- Import map para resolver 'three' e 'three/addons' -->
  <script type="importmap">
  {
    "imports": {
      "three": "https://cdn.jsdelivr.net/npm/three@0.160/build/three.module.js",
      "three/addons/": "https://cdn.jsdelivr.net/npm/three@0.160/examples/jsm/"
    }
  }
  </script>

<script type="module">
import * as THREE from 'three';

const $ = s => document.querySelector(s);
const canvas = $('#game');
const hud = {
  score: $('#score'), wave: $('#wave'), combo: $('#combo'),
  boost: $('#boostBar'), shield: $('#shieldBar'),
  best: $('#best'), toast: $('#toast'),
  mapWrap: $('#mapWrap'), map: $('#map'), mapState: $('#mapState')
};
const sensInput = $('#sens'), volInput = $('#vol');
const pauseOverlay = $('#pause');
const btnHelp = $('#btnHelp'), btnResume = $('#btnResume'), btnReset = $('#btnReset'), btnClear = $('#btnClearSave');

// Renderer/scene/camera
const renderer = new THREE.WebGLRenderer({canvas, antialias:true});
renderer.setPixelRatio(Math.min(devicePixelRatio, 2));
const scene = new THREE.Scene();
const camera = new THREE.PerspectiveCamera(75, 1, 0.1, 2000);
camera.position.set(0, 10, 22);
onResize(); addEventListener('resize', onResize);
function onResize(){ const w=innerWidth,h=innerHeight-48; renderer.setSize(w,h,false); camera.aspect=w/h; camera.updateProjectionMatrix(); }

// Stars background
scene.background = new THREE.Color(0x03040a);
const starsGeo = new THREE.BufferGeometry();
const starCount = 2000;
const starPos = new Float32Array(starCount*3);
for (let i=0;i<starCount;i++){
  starPos[i*3] = (Math.random()-0.5)*1200;
  starPos[i*3+1] = (Math.random()-0.5)*1200;
  starPos[i*3+2] = (Math.random()-0.5)*1200;
}
starsGeo.setAttribute('position', new THREE.BufferAttribute(starPos,3));
const stars = new THREE.Points(starsGeo, new THREE.PointsMaterial({color:0xffffff,size:1}));
scene.add(stars);

// Lights
const ambient = new THREE.AmbientLight(0x8080a0, .6); scene.add(ambient);
const spot = new THREE.SpotLight(0xffffff, 0.0, 120, Math.PI/5, 0.5, 1.2); // farol
scene.add(spot);

// Ship
const ship = new THREE.Group();
scene.add(ship);
const hull = new THREE.Mesh(
  new THREE.ConeGeometry(0.9, 3, 12), new THREE.MeshStandardMaterial({color:0x8f0000, metalness:.3, roughness:.5})
);
hull.rotation.x = Math.PI/2; ship.add(hull);
const wingL = new THREE.Mesh(new THREE.BoxGeometry(1.6, .1, .4), new THREE.MeshStandardMaterial({color:0x222}));
wingL.position.set(-1,0,0); ship.add(wingL);
const wingR = wingL.clone(); wingR.position.x = 1; ship.add(wingR);
const engine = new THREE.PointLight(0xff5522, 1, 8); engine.position.set(0,-1.3,0); ship.add(engine);
spot.position.set(0,2,5); spot.target = ship;

// Game state
const state = {
  pos: new THREE.Vector3(0,0,0),
  vel: new THREE.Vector3(0,0,0),
  yaw: 0, pitch: 0,
  boost: .6, shield: 1,
  score: 0, best: Number(localStorage.getItem('arcade_space_best')||0),
  combo: 1, comboTimer: 0,
  wave: 1, alive: true, paused: false,
  mapOn: false
};
hud.best.textContent = state.best;

// Controls
const keys = {};
addEventListener('keydown', e=>{
  keys[e.code]=true;
  if(e.code==='KeyP'){ togglePause(); }
  if(e.code==='KeyM'){ state.mapOn = !state.mapOn; hud.mapWrap.style.display = state.mapOn?'block':'none'; hud.mapState.textContent = state.mapOn?'ON':'OFF'; }
  if(e.code==='KeyF'){ spot.intensity = spot.intensity>0 ? 0 : 1.1; }
});
addEventListener('keyup', e=> keys[e.code]=false);
let aim = new THREE.Vector2(0,0);
addEventListener('mousemove', e=>{
  const sens = Number(sensInput.value);
  aim.x = ((e.clientX/innerWidth)-0.5)*2*sens;
  aim.y = ((e.clientY/(innerHeight-48))-0.5)*2*sens;
});
addEventListener('click', ()=> shoot());

// Mobile pad
const pad=$('#pad'), stick=$('#stick'), btnShoot=$('#btnShoot'), btnBoost=$('#btnBoost');
let touch={ax:0,ay:0}; if(/Mobi|Android/i.test(navigator.userAgent)){ $('#mobile').style.display='flex'; initPad(); }
function initPad(){
  let drag=false,sx=0,sy=0;
  pad.addEventListener('touchstart', e=>{ drag=true; const t=e.touches[0]; sx=t.clientX; sy=t.clientY; e.preventDefault(); });
  pad.addEventListener('touchmove', e=>{
    if(!drag) return; const t=e.touches[0]; const clamp=(v)=>Math.max(-45,Math.min(45,v));
    const dx=clamp(t.clientX-sx), dy=clamp(t.clientY-sy);
    stick.style.left=(32+dx)+'px'; stick.style.top=(32+dy)+'px';
    touch.ax = dx/45; touch.ay = dy/45;
  }, {passive:false});
  const stop=()=>{drag=false; stick.style.left='32px'; stick.style.top='32px'; touch.ax=0; touch.ay=0;};
  pad.addEventListener('touchend', stop); pad.addEventListener('touchcancel', stop);
  btnShoot.addEventListener('touchstart', ()=> shoot());
  btnBoost.addEventListener('touchstart', ()=> keys['ShiftLeft']=true);
  btnBoost.addEventListener('touchend', ()=> keys['ShiftLeft']=false);
}

// Audio
const AC = window.AudioContext? new AudioContext(): null;
function beep(freq=440, dur=0.07, gain=0.12){
  if(!AC) return;
  const o=AC.createOscillator(), g=AC.createGain();
  o.type='triangle'; o.frequency.value=freq;
  g.gain.value = Number(volInput.value)*gain;
  o.connect(g).connect(AC.destination);
  o.start(); o.stop(AC.currentTime+dur);
}

// Asteroids, bullets, pickups
const asteroids = [], bullets = [], pickups = [];
function spawnAsteroid(r=1+Math.random()*2){
  const geo = new THREE.IcosahedronGeometry(r, 1);
  const mat = new THREE.MeshStandardMaterial({color:0x6b625d, roughness:0.95});
  const m = new THREE.Mesh(geo, mat);
  m.position.set((Math.random()-0.5)*80, (Math.random()-0.5)*12, -120 - Math.random()*120);
  m.userData = { vel: new THREE.Vector3((Math.random()-0.5)*2, (Math.random()-0.5)*0.3, 12+Math.random()*6), r };
  scene.add(m); asteroids.push(m);
}
function spawnPickup(){
  const geo = new THREE.BoxGeometry(.7,.7,.7);
  const mat = new THREE.MeshStandardMaterial({color:0x48d1ff, emissive:0x114455, emissiveIntensity:.6, metalness:.2, roughness:.3});
  const m = new THREE.Mesh(geo, mat);
  m.position.set((Math.random()-0.5)*60, (Math.random()-0.5)*8, -100 - Math.random()*80);
  m.userData = { vel: new THREE.Vector3(0,0, 10+Math.random()*4) };
  scene.add(m); pickups.push(m);
}
function shoot(){
  if(!state.alive || state.paused) return;
  const geo = new THREE.CylinderGeometry(0.08, 0.08, 1.6, 6);
  const mat = new THREE.MeshBasicMaterial({color:0xffe066});
  const b = new THREE.Mesh(geo, mat);
  b.rotation.x = Math.PI/2;
  b.position.copy(ship.position).add(new THREE.Vector3(0,-0.4,-1.2).applyAxisAngle(new THREE.Vector3(0,1,0), state.yaw));
  b.userData = { vel: new THREE.Vector3(Math.sin(state.yaw)*30, -state.pitch*10, -Math.cos(state.yaw)*30) };
  scene.add(b); bullets.push(b); beep(880,.05,.12);
}

// UI/Pausa
let paused=false;
function togglePause(){ paused=!paused; state.paused=paused; pauseOverlay.classList.toggle('open', paused); }
btnHelp.onclick = ()=>{ paused=true; state.paused=true; pauseOverlay.classList.add('open'); };
btnResume.onclick = ()=> togglePause();
btnReset.onclick = ()=> resetGame();
btnClear.onclick = ()=>{ localStorage.removeItem('arcade_space_best'); hud.best.textContent='—'; }

// HUD
function toast(txt){ hud.toast.textContent=txt; hud.toast.style.display='block'; setTimeout(()=> hud.toast.style.display='none', 700); }
function updateHUD(){
  hud.score.textContent = state.score;
  hud.wave.textContent = state.wave;
  hud.combo.textContent = 'x'+state.combo;
  hud.boost.style.width = (state.boost*100|0)+'%';
  hud.shield.style.width = (state.shield*100|0)+'%';
}

// Map
const mctx = hud.map.getContext('2d');
function drawMap(){
  const ctx=mctx,c=hud.map; ctx.clearRect(0,0,c.width,c.height);
  ctx.fillStyle='#0f1116'; ctx.fillRect(0,0,c.width,c.height); ctx.strokeStyle='#24262b'; ctx.strokeRect(0,0,c.width,c.height);
  const sx=80, sy=80, sc=1.2;
  // player
  const px = sx + ship.position.x*sc, py = sy + ship.position.z*sc*0.6;
  ctx.fillStyle='#ff4a4a'; ctx.beginPath(); ctx.arc(px,py,3,0,6.28); ctx.fill();
  // asteroids
  ctx.fillStyle='#aaa';
  asteroids.forEach(a=>{ const x=sx+a.position.x*sc, y=sy+a.position.z*sc*0.6; if(x>0&&x<160&&y>0&&y<160) ctx.fillRect(x,y,2,2); });
  // pickups
  ctx.fillStyle='#48d1ff';
  pickups.forEach(p=>{ const x=sx+p.position.x*sc, y=sy+p.position.z*sc*0.6; if(x>0&&x<160&&y>0&&y<160) ctx.fillRect(x,y,2,2); });
}

// Spawn inicial
for(let i=0;i<18;i++) spawnAsteroid();
for(let i=0;i<4;i++) spawnPickup();

// Loop
let last=performance.now();
function loop(){
  requestAnimationFrame(loop);
  if(paused) return;
  const now=performance.now(); const dt=Math.min(0.05,(now-last)/1000); last=now;

  // input
  const ax = (keys['KeyA']||keys['ArrowLeft']?-1:0) + (keys['KeyD']||keys['ArrowRight']?1:0) + touch.ax;
  const ay = (keys['KeyW']||keys['ArrowUp']?-1:0) + (keys['KeyS']||keys['ArrowDown']?1:0) + touch.ay;
  const boosting = (keys['ShiftLeft']||keys['ShiftRight']) && state.boost>0.1;

  // mira suavizada (gira a nave)
  state.yaw = Math.atan2(aim.x, 1.0);
  state.pitch = THREE.MathUtils.lerp(state.pitch, aim.y*0.6, 1-Math.exp(-dt*3));

  // movimento
  const accel = new THREE.Vector3(ax* (boosting? 55:35)*dt, 0, ay* (boosting? 55:35)*dt);
  state.vel = state.vel || new THREE.Vector3();
  state.vel.add(accel).multiplyScalar(0.92);
  state.pos.add(state.vel.clone().multiplyScalar(dt*10));
  // limites suaves
  state.pos.x = THREE.MathUtils.clamp(state.pos.x, -40, 40);
  state.pos.z = THREE.MathUtils.clamp(state.pos.z, -20, 20);

  ship.position.set(state.pos.x, 0, state.pos.z);
  ship.rotation.set(state.pitch, state.yaw, -ax*0.2);

  // câmera segue
  const camTarget = new THREE.Vector3(state.pos.x, 10, 22);
  camera.position.lerp(camTarget, 1-Math.exp(-dt*5));
  camera.lookAt(ship.position.clone().add(new THREE.Vector3(0,-1,-8)));
  spot.position.copy(ship.position.clone().add(new THREE.Vector3(0,2,5)));

  // boost
  state.boost += (boosting? -dt*0.35 : dt*0.22); state.boost = THREE.MathUtils.clamp(state.boost,0,1);

  // mover asteroides/pickups para frente
  asteroids.forEach((a)=>{
    a.rotation.x += dt*.2; a.rotation.y += dt*.3;
    a.position.addScaledVector(a.userData.vel, dt);
    if(a.position.z>40){ a.position.z = -140 - Math.random()*60; a.position.x = (Math.random()-0.5)*80; }
    // colisão com nave
    if(a.position.distanceTo(ship.position) < (a.userData.r+0.9)){
      state.shield -= 0.3; a.position.z += -40 - Math.random()*60; beep(120,.06,.2); toast('Impacto!');
      if(state.shield<=0){ gameOver(); }
    }
  });
  pickups.forEach((p)=>{
    p.rotation.y += dt*2;
    p.position.addScaledVector(p.userData.vel, dt);
    if(p.position.z>40){ p.position.z=-100-Math.random()*60; p.position.x=(Math.random()-0.5)*60; }
    if(p.position.distanceTo(ship.position) < 1.8){
      state.score += 150*state.combo; state.combo = Math.min(10, state.combo+1); state.comboTimer = 2.5;
      state.shield = Math.min(1, state.shield + 0.15); p.position.z = -120 - Math.random()*80;
      toast('+DATA'); beep(980,.07,.14);
    }
  });

  // bullets
  for(let i=bullets.length-1;i>=0;i--){
    const b=bullets[i]; b.position.addScaledVector(b.userData.vel, dt);
    if(b.position.length()>400){ scene.remove(b); bullets.splice(i,1); continue; }
    // colisão com asteroides
    for(let j=asteroids.length-1;j>=0;j--){
      const a=asteroids[j];
      if(a.position.distanceTo(b.position) < a.userData.r+0.3){
        scene.remove(b); bullets.splice(i,1);
        explode(a.position, a.userData.r);
        state.score += 100*state.combo; state.combo=Math.min(10,state.combo+1); state.comboTimer=2.0; beep(660,.05,.15);
        a.position.z = -140 - Math.random()*100; a.position.x=(Math.random()-0.5)*80; // recicla
        break;
      }
    }
  }

  // combo timer
  state.comboTimer -= dt; if(state.comboTimer<=0) state.combo = Math.max(1, state.combo-1);

  // waves (aumenta velocidade e densidade aos poucos)
  const targetAst = 18 + state.wave*2;
  if(asteroids.length < targetAst) spawnAsteroid(1+Math.random()*2);
  if(Math.random()<0.005) spawnPickup();
  if(Math.floor(state.score/1200)+1 > state.wave){ state.wave++; toast('Wave '+state.wave); }

  // map
  if(state.mapOn) drawMap();

  updateHUD();
  renderer.render(scene, camera);
}
loop();

// Explosão simples com pontos
function explode(pos, r=2){
  const geo=new THREE.BufferGeometry();
  const n=80; const arr=new Float32Array(n*3); const vel=[];
  for(let i=0;i<n;i++){
    const v=new THREE.Vector3((Math.random()-0.5)*r,(Math.random()-0.5)*r,(Math.random()-0.5)*r);
    arr.set([pos.x,pos.y,pos.z], i*3); vel.push(v);
  }
  geo.setAttribute('position', new THREE.BufferAttribute(arr,3));
  const pts=new THREE.Points(geo, new THREE.PointsMaterial({color:0xffcc88,size:0.8}));
  scene.add(pts);
  let t=0; (function anim(){
    t+=0.016; const p=geo.attributes.position;
    for(let i=0;i<n;i++){ p.setXYZ(i, p.getX(i)+vel[i].x, p.getY(i)+vel[i].y, p.getZ(i)+vel[i].z); }
    p.needsUpdate=true; if(t<0.5) requestAnimationFrame(anim); else scene.remove(pts);
  })();
}

// Score/save
function gameOver(){
  if(!state.alive) return;
  state.alive=false; toast('Game Over');
  if(state.score>state.best){ state.best=state.score; localStorage.setItem('arcade_space_best', String(state.best)); hud.best.textContent=state.best; }
  paused=true; state.paused=true; pauseOverlay.classList.add('open');
}
function resetGame(){
  state.pos.set(0,0,0); state.vel.set(0,0,0);
  state.boost=.6; state.shield=1; state.score=0; state.combo=1; state.comboTimer=0; state.wave=1; state.alive=true;
  paused=false; state.paused=false; pauseOverlay.classList.remove('open');
}

// Buttons in modal
btnResume.onclick = ()=> togglePause();
btnReset.onclick = ()=> resetGame();
btnClear.onclick = ()=> { localStorage.removeItem('arcade_space_best'); state.best=0; hud.best.textContent='—'; };
</script>
